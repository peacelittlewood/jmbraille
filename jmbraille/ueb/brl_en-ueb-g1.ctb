include brl_en-ueb-chardefs.uti UEB specific char defs.
#   some dots are undefined now
#   include en-ueb-math.ctb UEB math from common linear format
include brl_tex.tbl

numsign 3456  number sign, just a dots operand
numericmodechars .,
nocontractsign 56
nonumsign 56
numericnocontchars abcdefghijABCDEFGHIJ

# A capital ends numeric mode, so clean up extraneous letter indicators between a number
# and a subsequent capital letter
noback pass2 _$D[@6-6-56]$U @6-6            # handle "1234CARD"
noback pass2 _$D[@6-56]$U @6                # handle "1234Card"
noback pass2 _$D[@d-256-ae-6-6-56]$U @d-256-ae-6-6    # handle "1234.CARD"
noback pass2 _$D[@d-256-ae-6-56]$U @d-256-ae-6        # handle "1234.Card"

# Correct order of comma and numeric indicator
match %a , %# d-2-ae-34569  force correct position of numeric indicator
noback pass2 @3456-d-2-ae-34569 @d-2-ae-3456    Clear up extra indicator after the match line

# Correct order of dot and numeric indicator
match %a . %# d-256-ae-34569  force correct position of numeric indicator
noback pass2 @3456-d-256-ae-34569 @d-256-ae-3456    Clear up extra indicator after the match line

# numeric space
#noback correct _$d["\x00a0"]$d     "\xE020"   # change space to custom symbol representing numeric space
#litdigit \xE020 5a                        # add virtual dot to make distinction with other uses of dot 5
#noback pass2   @5a             @5

capsletter 6
begcapsword 6-6
endcapsword d-6-3-ae
lencapsphrase 3
begcapsphrase 6-6-6
endcapsphrase after d-6-3-ae

emphclass italic      #0
emphclass underline   #1
emphclass bold        #2
emphclass script      #3
emphclass transnote   #4
emphclass trans1      #5
emphclass trans2      #6
emphclass trans3      #7
emphclass trans4      #8
emphclass trans5      #9

emphletter italic d-46-23-ae
begemphword italic d-46-2-ae
endemphword italic d-46-3-ae
lenemphphrase italic 3
begemphphrase italic d-46-2356-ae
endemphphrase italic after d-46-3-ae

emphletter bold d-45-23-ae
begemphword bold d-45-2-ae
endemphword bold d-45-3-ae
lenemphphrase bold 3
begemphphrase bold d-45-2356-ae
endemphphrase bold after d-45-3-ae

emphletter underline d-456-23-ae
begemphword underline d-456-2-ae
endemphword underline d-456-3-ae
lenemphphrase underline 3
begemphphrase underline d-456-2356-ae
endemphphrase underline after d-456-3-ae

emphletter script d-4-23-ae
begemphword script d-4-2-ae
endemphword script d-4-3-ae
lenemphphrase script 3
begemphphrase script d-4-2356-ae
endemphphrase script after d-4-3-ae

begemph transnote d-4-46-126-ae
endemph transnote d-4-46-354-ae


emphletter trans1 d-4-3456-23-ae
begemphword trans1 d-4-3456-2-ae
endemphword trans1 d-4-3456-3-ae
lenemphphrase trans1 3
begemphphrase trans1 d-4-3456-2356-ae
endemphphrase trans1 after d-4-3456-3-ae

emphletter trans2 d-45-3456-23-ae
begemphword trans2 d-45-3456-2-ae
endemphword trans2 d-45-3456-3-ae
lenemphphrase trans2 3
begemphphrase trans2 d-45-3456-2356-ae
endemphphrase trans2 after d-45-3456-3-ae

emphletter trans3 d-456-3456-23-ae
begemphword trans3 d-456-3456-2-ae
endemphword trans3 d-456-3456-3-ae
lenemphphrase trans3 3
begemphphrase trans3 d-456-3456-2356-ae
endemphphrase trans3 after d-456-3456-3-ae

emphletter trans4 d-5-3456-23-ae
begemphword trans4 d-5-3456-2-ae
endemphword trans4 d-5-3456-3-ae
lenemphphrase trans4 3
begemphphrase trans4 d-5-3456-2356-ae
endemphphrase trans4 after d-5-3456-3-ae

emphletter trans5 d-46-3456-23-ae
begemphword trans5 d-46-3456-2-ae
endemphword trans5 d-46-3456-3-ae
lenemphphrase trans5 3
begemphphrase trans5 d-46-3456-2356-ae
endemphphrase trans5 after d-46-3456-3-ae



# display/passthrough for unicode braille
# include brl_braille-patterns.cti
